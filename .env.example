# Copy to .env.local and fill in. Never commit .env.local.

# --- App ---
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/chaser.db
# Pin "today" for a repeatable demo (ISO date). Leave empty to use the real date.
DEMO_NOW=

# --- Owner authentication and email delivery ---
# Single account allowed; this must be an email address you control.
AUTH_OWNER_EMAIL=
# Generate a private random secret of at least 32 characters. Never commit it.
BETTER_AUTH_SECRET=
# Needed to send password reset, email verification, and login OTP messages.
RESEND_API_KEY=
# Testing sender; Resend restricts recipients until you verify a domain.
RESEND_FROM=PayPal Hackathon <onboarding@resend.dev>

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_PROVIDER= blank auto-selects OpenAI-compatible when LLM_API_KEY exists, else Anthropic
LLM_PROVIDER=
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/ | gemini-3.8-flash
# Groq: https://api.groq.com/openai/v1 | openai/gpt-oss-20b
# OpenRouter (free router): https://openrouter.ai/api/v1 | openrouter/free
# Capabilities and free quotas may vary/change by provider and model.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_HISTORY=20
# auto = scripted when selected provider has no usable key, live otherwise
# live = always call the API; scripted = canned responses (offline demo / CI fallback)
LLM_MODE=auto

# --- PayPal (Sandbox only) ---
# "mock" = fully fake PayPal, no network. "sandbox" = real Sandbox API.
PAYPAL_MODE=mock
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Created in the PayPal developer dashboard once you have a public URL (ngrok / cloudflared)
PAYPAL_WEBHOOK_ID=
# Sandbox business account email used as the invoicer (optional, informational)
PAYPAL_SANDBOX_MERCHANT_EMAIL=
# Sandbox personal (buyer) account email used as the demo client's invoice recipient
PAYPAL_SANDBOX_BUYER_EMAIL=
